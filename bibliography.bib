@article{tognon_aerial_2018,
	title = {Aerial Co-Manipulation With Cables: The Role of Internal Force for Equilibria, Stability, and Passivity},
	volume = {3},
	issn = {2377-3766},
	url = {https://ieeexplore.ieee.org/document/8286868},
	doi = {10.1109/LRA.2018.2803811},
	shorttitle = {Aerial Co-Manipulation With Cables},
	abstract = {This letter considers the cooperative manipulation of a cable-suspended load with two generic aerial robots without the need of explicit communication. The role of the internal force for the asymptotic stability of the beam position-and-attitude equilibria is analyzed in depth. Using a nonlinear Lyapunov-based approach, we prove that if a nonzero internal force is chosen, then the asymptotic stabilization of any desired beam attitude can be achieved with a decentralized and communicationless master–slave admittance controller. If, conversely, a zero internal force is chosen, as done in the majority of the state-of-the-art algorithms, the attitude of the beam is not controllable without communication. Furthermore, we formally proof the output-strictly passivity of the system with respect to an energy-like storage function and a certain input–output pair. This proves the stability and the robustness of the method during motion and in nonideal. The theoretical findings are validated through extensive simulations.},
	pages = {2577--2583},
	number = {3},
	journal = {{IEEE} Robotics and Automation Letters},
	author = {Tognon, Marco and Gabellieri, Chiara and Pallottino, Lucia and Franchi, Antonio},
	urldate = {2026-01-07},
	date = {2018-07},
    year = {2018},
	keywords = {multi-robot systems, Transportation, Force, Robot kinematics, Admittance, Aerial systems: mechanics and control, distributed robot systems, mobile manipulation, Stability criteria},
	file = {Full Text PDF:C\:\\Users\\chchi\\Zotero\\storage\\PM75VQUF\\Tognon et al. - 2018 - Aerial Co-Manipulation With Cables The Role of Internal Force for Equilibria, Stability, and Passiv.pdf:application/pdf},
}


@article{jamshidifar_static_2020,
	title = {Static Workspace Optimization of Aerial Cable Towed Robots With Land-Fixed Winches},
	volume = {36},
	issn = {1941-0468},
	url = {https://ieeexplore.ieee.org/document/9119199},
	doi = {10.1109/TRO.2020.2998613},
	abstract = {This article focuses on the static workspace ({SW}) of aerial cable towed robots ({ACTRs}) with land-fixed winches and provides an optimization approach to maximize the size of such a workspace. In the structure of the studied robots, land-fixed winches beside the {ACTRs}, actuated by unmanned aerial vehicles ({UAVs}), are used to manipulate a platform to reach high-altitude poses and balance platform's interaction force/moment in such poses. Capability of {UAVs} in choosing and holding different positions and orientations enables the studied robots to adapt their available net wrench set ({AW}) to various required net wrench sets. In order to find the {SW} of {ACTRs} with land-fixed winches, at first, {AW} of a generic robot for a given arrangement of {UAVs} is developed analytically. Then, a geometrical approach is provided to find all collision-free arrangements of the {UAVs}. Based on that, a performance index is derived and optimized to find an optimal collision-free arrangement of the {UAVs}, which maximizes the magnitude of the force that can be balanced by the platform in any arbitrary direction. Finally, the application of the proposed optimization approach in size maximization of the {SW} is shown in an example.},
	pages = {1603--1610},
	number = {5},
	journal = {{IEEE} Transactions on Robotics},
	author = {Jamshidifar, Hamed and Khajepour, Amir},
	urldate = {2025-12-21},
	date = {2020-10},
    year = {2020},
	keywords = {Unmanned aerial vehicles, Cable-driven parallel robots ({CDPRs}), Collision avoidance, Force, optimal arrangement, Optimization, Robots, Surface acoustic waves, unmanned aerial vehicles ({UAVs}), Winches, wrench-feasible workspace},
	file = {Full Text PDF:C\:\\Users\\chchi\\Zotero\\storage\\GER72VGL\\Jamshidifar e Khajepour - 2020 - Static Workspace Optimization of Aerial Cable Towed Robots With Land-Fixed Winches.pdf:application/pdf;Snapshot:C\:\\Users\\chchi\\Zotero\\storage\\XPRYEE79\\9119199.html:text/html},
