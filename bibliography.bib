	file = {Full text:C\:\\Users\\chchi\\Zotero\\storage\\JHTRJESV\\Sanalitro et al. - 2022 - Indirect Force Control of a Cable-Suspended Aerial Multi-Robot Manipulator.pdf:application/pdf;Snapshot:C\:\\Users\\chchi\\Zotero\\storage\\EWF3XWQB\\9779498.html:text/html},
