    year = {2019},
	note = {{ISSN}: 2577-087X},
	keywords = {Aerial Systems, Cable-Driven Parallel Robots, Control, Dynamics, Kinematics, Mathematical model, Multi-Robot Systems, Payloads, Propulsion, Quadrotors, Reconfiguration, Trajectory, Vehicle dynamics},
	file = {Snapshot:C\:\\Users\\chchi\\Zotero\\storage\\BBQXZ249\\8794396.html:text/html;Versione inviata:C\:\\Users\\chchi\\Zotero\\storage\\3FG4K6LH\\Erskine et al. - 2019 - Control and Configuration Planning of an Aerial Cable Towed System.pdf:application/pdf},
